    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.4.13",
    "astro-seo": "^1.2.0",
    "leaflet": "^1.9.4",
    "lucide-astro": "^0.556.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "1.5.4",
    "tailwindcss": "^4.3.5"
