---
import Button from '~/components/Button.astro';
import { MIN_SHARES, PAR_VALUE, PAID_WITH_APPLICATION, MEMBERSHIP_FEE, WELFARE_MONTHLY, formatAmount } from '~/lib/subscription';
import { PMES_SELF_PACED } from '~/data/pmes-online';
import { VALID_ID_TYPES, EMPLOYMENT_STATUSES } from '~/lib/membership-record';

/** staff: a walk-in's paper form typed in by the presenter (/pmes/admin/walk-in/); no Turnstile, no PDF. */
interface Props { staff?: boolean }
const { staff = false } = Astro.props;
const CAMPUSES = ['Main La Paz', 'Dumangas', 'Barotac Nuevo', 'Leon', 'Miag-ao'];
const EMPLOYMENT_CATS = ['Employed', 'Self-Employed', 'Retired', 'Unemployed', 'Others'];
---
<form id="membership-form" class="bg-white border-t-[3px] border-orange rounded-b-lg p-6 md:p-8 space-y-6" novalidate data-staff={staff ? '1' : undefined}>
  <input type="hidden" name="form-source" value="membership" />
  <input type="hidden" name="name" value="" />
  <input type="hidden" name="message" value="" />
  <input type="hidden" name="applicant" value="" />

  <p class="text-xs text-slate -mt-2">Only fields marked <span class="text-orange" aria-hidden="true">*</span> are required. Fill what you can now — when you submit, we'll generate your pre-filled application and subscription agreement (one 2-page PDF) for you to download, print, sign, and bring to the office for in-person verification.</p>

  <fieldset class="space-y-3">
    <legend class="font-display font-bold text-navy text-sm uppercase tracking-wider">1. Membership type <span class="text-orange" aria-hidden="true">*</span></legend>
    <p class="text-xs text-slate">Which one fits you? Choose first: the rest of the form follows your answer.</p>
    <div class="grid md:grid-cols-2 gap-3">
      <label class="flex items-start gap-3 text-sm border-2 border-rule rounded-md p-3 cursor-pointer has-[:checked]:border-navy">
        <input type="radio" data-field="memberType" name="mf-membertype" value="Regular" required class="mt-1" />
        <span><strong class="text-navy">Regular member</strong><br />You are a <strong>regular employee of ISAT U</strong> (any campus) or of the cooperative. Full voting rights.</span>
      </label>
      <label class="flex items-start gap-3 text-sm border-2 border-rule rounded-md p-3 cursor-pointer has-[:checked]:border-navy">
        <input type="radio" data-field="memberType" name="mf-membertype" value="Associate" class="mt-1" />
        <span><strong class="text-navy">Associate member</strong><br />You are an <strong>ISAT U alumnus</strong>, a <strong>parent, spouse or adult child of a regular member</strong>, a <strong>non-regular ISAT U employee</strong>, or recommended by a regular member.</span>
      </label>
    </div>

    <div id="mf-regular-block" class="hidden border-l-2 border-orange/40 pl-4 space-y-3">
      <label class="flex items-center gap-2 text-sm">
        <input id="mf-isatu" data-field="isatuEmployee" type="checkbox" />
        I'm a regular ISAT U employee
      </label>
      <div id="mf-campus-row" class="hidden">
        <label for="mf-campus" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Campus assigned</label>
        <select id="mf-campus" data-field="campus" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm bg-white max-w-xs">
          <option value="">Select campus…</option>
          {CAMPUSES.map(c => <option value={c}>{c}</option>)}
        </select>
        <div class="mt-3 max-w-xs">
          <label for="mf-office" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Office or college</label>
          <input id="mf-office" data-field="office" type="text" maxlength="200" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
        </div>
        <p class="text-xs text-slate mt-2">You will sign an Authority to Deduct from Salary at the office: any shares you subscribe above {PAID_WITH_APPLICATION} and, ages 18 to 55, the Welfare Fund (PHP {formatAmount(WELFARE_MONTHLY)} a month) are deducted from your ISAT U salary.</p>
        <p id="mf-deduction" class="text-sm text-navy font-semibold mt-1" aria-live="polite"></p>
      </div>
    </div>

    <div id="mf-associate-block" class="hidden border-l-2 border-orange/40 pl-4 space-y-4">
      <div>
        <span class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-2">Qualification</span>
        <div class="space-y-2">
          <label class="flex items-start gap-2 text-sm"><input type="radio" data-field="associateQualification" name="mf-assocqual" value="relationship" class="mt-1" /> <span>Relationship to a regular member</span></label>
          <label class="flex items-start gap-2 text-sm"><input type="radio" data-field="associateQualification" name="mf-assocqual" value="integrity" class="mt-1" /> <span>Individual of proven integrity in the community</span></label>
          <label class="flex items-start gap-2 text-sm"><input type="radio" data-field="associateQualification" name="mf-assocqual" value="organization" class="mt-1" /> <span>Member of an organization/group registered with SEC or other regulating agencies</span></label>
        </div>
      </div>
      <div id="mf-assocorg-row" class="hidden">
        <label for="mf-assocorg" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Please specify</label>
        <input id="mf-assocorg" data-field="associateOrgSpecify" type="text" maxlength="200" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div class="grid md:grid-cols-3 gap-3">
        <div>
          <label for="mf-recname" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Recommended by <span class="text-orange" aria-hidden="true">*</span></label>
          <input id="mf-recname" data-field="recommenderName" type="text" maxlength="200" placeholder="Regular member's full name" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="mf-recrel" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Relationship to that member</label>
          <input id="mf-recrel" data-field="recommenderRelationship" type="text" maxlength="200" placeholder="Parent, spouse, child, friend…" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="mf-reccampus" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">If they're ISAT U: campus/college</label>
          <input id="mf-reccampus" data-field="recommenderCampus" type="text" maxlength="200" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
        </div>
      </div>
    </div>
  </fieldset>

  <fieldset class="space-y-4">
    <legend class="font-display font-bold text-navy text-sm uppercase tracking-wider">2. Identity</legend>
    <div class="grid md:grid-cols-4 gap-3">
      <div>
        <label for="mf-first" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">First name <span class="text-orange" aria-hidden="true">*</span></label>
        <input id="mf-first" data-field="firstName" type="text" maxlength="200" required class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-middle" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Middle name</label>
        <input id="mf-middle" data-field="middleName" type="text" maxlength="200" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-last" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Last name <span class="text-orange" aria-hidden="true">*</span></label>
        <input id="mf-last" data-field="lastName" type="text" maxlength="200" required class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-ext" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Extension</label>
        <input id="mf-ext" data-field="extension" type="text" maxlength="200" placeholder="Jr., III…" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-3">
      <div>
        <label for="mf-dob" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Date of birth <span class="text-orange" aria-hidden="true">*</span></label>
        <input id="mf-dob" data-field="dob" type="date" required class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-pob" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Place of birth</label>
        <input id="mf-pob" data-field="placeOfBirth" type="text" maxlength="200" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-3">
      <div>
        <label for="mf-email" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Email <span class="text-orange" aria-hidden="true">*</span></label>
        <input id="mf-email" name="email" type="email" maxlength="200" required class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-phone" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Contact number <span class="text-orange" aria-hidden="true">*</span></label>
        <input id="mf-phone" data-field="contactNumber" type="tel" maxlength="200" required inputmode="tel" placeholder="09xx xxx xxxx" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <span class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-2">Gender</span>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 text-sm"><input type="radio" data-field="gender" name="mf-gender" value="Male" /> Male</label>
          <label class="flex items-center gap-2 text-sm"><input type="radio" data-field="gender" name="mf-gender" value="Female" /> Female</label>
        </div>
      </div>
      <div>
        <span class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-2">Civil status</span>
        <div class="flex flex-wrap gap-4">
          <label class="flex items-center gap-2 text-sm"><input type="radio" data-field="civilStatus" name="mf-civil" value="Single" /> Single</label>
          <label class="flex items-center gap-2 text-sm"><input type="radio" data-field="civilStatus" name="mf-civil" value="Married" /> Married</label>
          <label class="flex items-center gap-2 text-sm"><input type="radio" data-field="civilStatus" name="mf-civil" value="Separated" /> Separated</label>
        </div>
      </div>
    </div>
  </fieldset>

  <fieldset class="space-y-4">
    <legend class="font-display font-bold text-navy text-sm uppercase tracking-wider">3. Address &amp; ID</legend>
    <div class="grid md:grid-cols-2 gap-3">
      <div>
        <label for="mf-paddr" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Present home address <span class="text-orange" aria-hidden="true">*</span></label>
        <input id="mf-paddr" data-field="presentHomeAddress" type="text" maxlength="200" required class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-haddr" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Permanent home address</label>
        <input id="mf-haddr" data-field="homeAddress" type="text" maxlength="200" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm read-only:bg-brand-bg" />
        <label class="flex items-center gap-2 text-xs text-slate mt-1"><input id="mf-sameaddr" type="checkbox" /> Same as present home address</label>
      </div>
    </div>
    <div class="grid md:grid-cols-2 gap-3">
      <div>
        <label for="mf-tin" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">TIN number</label>
        <input id="mf-tin" data-field="tinNumber" type="text" maxlength="200" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-gsis-sss" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">GSIS/SSS number</label>
        <input id="mf-gsis-sss" data-field="gsisSssNumber" type="text" maxlength="200" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-vid-type" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Valid ID type</label>
        <select id="mf-vid-type" data-field="validIdType" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm bg-white">
          <option value="">Select ID type…</option>
          {VALID_ID_TYPES.map(type => <option value={type.value}>{type.label}</option>)}
        </select>
      </div>
      <div>
        <label for="mf-vid" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Valid ID number (presented)</label>
        <input id="mf-vid" data-field="validIdNumber" type="text" maxlength="200" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
    </div>
  </fieldset>

  <fieldset class="space-y-4">
    <legend class="font-display font-bold text-navy text-sm uppercase tracking-wider">4. Employment</legend>
    <div>
      <span class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-2">Employment category <span class="text-orange" aria-hidden="true">*</span></span>
      <div class="flex flex-wrap gap-4">
        {EMPLOYMENT_CATS.map(cat => (
          <label class="flex items-center gap-2 text-sm">
            <input type="radio" data-field="employmentCategory" name="mf-empcat" value={cat} required />
            {cat}
          </label>
        ))}
      </div>
    </div>
    <div class="grid md:grid-cols-2 gap-3">
      <div>
        <label for="mf-empstatus" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Status of employment</label>
        <select id="mf-empstatus" data-field="statusOfEmployment" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm bg-white">
          <option value="">Select status…</option>
          {EMPLOYMENT_STATUSES.map(status => <option value={status.value}>{status.label}</option>)}
        </select>
      </div>
      <div>
        <label for="mf-prof" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Profession</label>
        <input id="mf-prof" data-field="profession" type="text" maxlength="200" placeholder="Faculty, Staff, etc." class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
    </div>
  </fieldset>

  <fieldset class="space-y-4">
    <legend class="font-display font-bold text-navy text-sm uppercase tracking-wider">5. Emergency contact</legend>
    <div class="grid md:grid-cols-3 gap-3">
      <div>
        <label for="mf-eman" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Name <span class="text-orange" aria-hidden="true">*</span></label>
        <input id="mf-eman" data-field="emergencyName" type="text" maxlength="200" required class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-emph" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Contact number <span class="text-orange" aria-hidden="true">*</span></label>
        <input id="mf-emph" data-field="emergencyContact" type="tel" maxlength="200" required inputmode="tel" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-emrel" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Relationship</label>
        <input id="mf-emrel" data-field="emergencyRelationship" type="text" maxlength="200" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
    </div>
  </fieldset>


  <fieldset class="space-y-3">
    <legend class="font-display font-bold text-navy text-sm uppercase tracking-wider">6. Share subscription <span class="text-orange" aria-hidden="true">*</span></legend>
    <p class="text-xs text-slate">Shares are PHP {PAR_VALUE}.00 each. Subscribe at least {MIN_SHARES} shares (PHP {formatAmount(MIN_SHARES * PAR_VALUE)}). At your office visit you pay the PHP {formatAmount(MEMBERSHIP_FEE)} membership fee and at least {PAID_WITH_APPLICATION} shares (PHP {formatAmount(PAID_WITH_APPLICATION * PAR_VALUE)}); shares above that are paid over the years you choose.</p>
    <div class="grid md:grid-cols-3 gap-3 items-end">
      <div>
        <label for="mf-shares" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Number of shares <span class="text-orange" aria-hidden="true">*</span></label>
        <input id="mf-shares" name="shares" data-field="sharesSubscribed" type="number" min={MIN_SHARES} step="1" value={MIN_SHARES} required class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-years" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Paid over (years) <span class="text-orange" aria-hidden="true">*</span></label>
        <input id="mf-years" name="years" data-field="yearsToPay" type="number" min="1" step="1" required class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <p id="mf-amount" class="text-sm text-navy font-semibold pb-2" aria-live="polite"></p>
    </div>
  </fieldset>

  {staff && <input type="radio" data-field="pmesMode" name="mf-pmesmode" value="in-person" checked hidden />}
  {PMES_SELF_PACED && !staff && (
    <fieldset class="space-y-3">
      <legend class="font-display font-bold text-navy text-sm uppercase tracking-wider">How will you take the PMES? <span class="text-orange" aria-hidden="true">*</span></legend>
      <div class="flex flex-wrap gap-4">
        <label class="flex items-center gap-2 text-sm"><input type="radio" data-field="pmesMode" name="mf-pmesmode" value="online" required /> Online: watch the videos and take the quiz on my phone</label>
        <label class="flex items-center gap-2 text-sm"><input type="radio" data-field="pmesMode" name="mf-pmesmode" value="in-person" /> In-person seminar</label>
      </div>
    </fieldset>
  )}

  <fieldset class="space-y-4">
    <legend class="font-display font-bold text-navy text-sm uppercase tracking-wider">7. Family information</legend>
    <div class="grid md:grid-cols-3 gap-3">
      <div>
        <label for="mf-spname" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Spouse's name<span id="mf-spname-star" class="hidden"> <span class="text-orange" aria-hidden="true">*</span></span></label>
        <input id="mf-spname" data-field="spouseName" type="text" maxlength="200" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-spdob" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Date of birth</label>
        <input id="mf-spdob" data-field="spouseDob" type="date" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-spph" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Contact no.</label>
        <input id="mf-spph" data-field="spouseContact" type="tel" maxlength="200" inputmode="tel" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
    </div>
    <div class="grid md:grid-cols-3 gap-3">
      <div>
        <label for="mf-pname" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Mother/father's name <span class="text-orange" aria-hidden="true">*</span></label>
        <input id="mf-pname" data-field="parentName" type="text" maxlength="200" required class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-pdob" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Date of birth</label>
        <input id="mf-pdob" data-field="parentDob" type="date" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="mf-pph" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Contact no.</label>
        <input id="mf-pph" data-field="parentContact" type="tel" maxlength="200" inputmode="tel" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
      </div>
    </div>
  </fieldset>

  <fieldset class="space-y-3">
    <legend class="font-display font-bold text-navy text-sm uppercase tracking-wider">8. Beneficiaries (at least 1, up to 2)</legend>
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="text-slate">Copy from Family information:</span>
      <button type="button" id="mf-ben-spouse" class="border-2 border-navy text-navy rounded-md px-3 py-1 font-semibold disabled:opacity-40 disabled:cursor-not-allowed" disabled>+ Spouse</button>
      <button type="button" id="mf-ben-parent" class="border-2 border-navy text-navy rounded-md px-3 py-1 font-semibold disabled:opacity-40 disabled:cursor-not-allowed" disabled>+ Parent</button>
      <span id="mf-ben-note" class="text-slate" aria-live="polite"></span>
    </div>
    {[1, 2].map(i => (
      <div class="grid grid-cols-2 md:grid-cols-[2fr_1.2fr_1.5fr_0.7fr] gap-2 items-end">
        <div>
          <label for={`mf-ben${i}-name`} class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">{`Beneficiary ${i} — name`}{i === 1 && <span class="text-orange" aria-hidden="true"> *</span>}</label>
          <input id={`mf-ben${i}-name`} data-field={`ben${i}Name`} type="text" maxlength="200" required={i === 1} class="w-full border-2 border-rule focus:border-navy rounded-md px-2 py-2 text-sm" />
        </div>
        <div>
          <label for={`mf-ben${i}-dob`} class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Date of birth</label>
          <input id={`mf-ben${i}-dob`} data-field={`ben${i}Dob`} type="date" class="w-full border-2 border-rule focus:border-navy rounded-md px-2 py-2 text-sm" />
        </div>
        <div>
          <label for={`mf-ben${i}-rel`} class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Relationship{i === 1 && <span class="text-orange" aria-hidden="true"> *</span>}</label>
          <input id={`mf-ben${i}-rel`} data-field={`ben${i}Rel`} type="text" maxlength="200" required={i === 1} class="w-full border-2 border-rule focus:border-navy rounded-md px-2 py-2 text-sm" />
        </div>
        <div>
          <label for={`mf-ben${i}-age`} class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Age</label>
          <input id={`mf-ben${i}-age`} data-field={`ben${i}Age`} type="number" min="0" max="120" class="w-full border-2 border-rule focus:border-navy rounded-md px-2 py-2 text-sm" />
        </div>
      </div>
    ))}
  </fieldset>

  <fieldset class="space-y-4">
    <legend class="font-display font-bold text-navy text-sm uppercase tracking-wider">9. A bit more</legend>
    <div>
      <label for="mf-affiliation" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Your connection to ISAT U or our community</label>
      <input id="mf-affiliation" data-field="affiliation" type="text" maxlength="200" placeholder="e.g. Faculty since 2018, alumna 2010, child of member …" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm" />
    </div>
    <div>
      <label for="mf-notes" class="block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1">Anything to add? <span class="text-slate font-normal normal-case tracking-normal">(optional)</span></label>
      <textarea id="mf-notes" maxlength="1000" data-field="notes" rows="3" class="w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm"></textarea>
    </div>
  </fieldset>

  {!staff && <div class="cf-turnstile" data-sitekey="0x4AAAAAADX7ERaWq-wd4wB5"></div>}
  <label class="flex items-start gap-2 text-sm">
    <input id="mf-consent" name="privacyConsent" type="checkbox" required class="mt-0.5" />
    {staff ? <span>The applicant signed the Data Privacy consent on the paper form. <span class="text-orange" aria-hidden="true">*</span></span> : <span>I have read the <a href="/privacy" class="underline underline-offset-2 text-navy font-semibold" target="_blank">Privacy Notice</a> and consent to ISATUCMPC collecting and processing the personal information in this form — including sensitive personal information such as my civil status — to process my membership application. <span class="text-orange" aria-hidden="true">*</span></span>}
  </label>
  {!staff && <div class="text-xs text-slate">By submitting, you agree to be contacted about next steps. We'll generate your pre-filled application and subscription agreement (PDF) for download. Print both pages, sign them, and bring them to the cooperative office for verification and PMES scheduling. You'll sign the Data Privacy Consent and your savings account forms at the office.</div>}
  <Button type="submit" variant="primary" size="md" showArrow>{staff ? 'Add walk-in and check in' : 'Submit & download my application'}</Button>
  <div id="mf-result" class="hidden p-3 rounded text-sm" role="status" aria-live="polite"></div>
  <div id="mf-cooldown" class="hidden p-3 rounded text-sm bg-brand-bg border border-rule" role="status" aria-live="polite"></div>
</form>

<script>
  import { fillApplicationPdf, triggerPdfDownload, type PdfFieldData } from '~/lib/pdf-fill';
  import { MIN_SHARES, PAR_VALUE, formatAmount } from '~/lib/subscription';
  import { buildApplicantRecord, buildApplicantMessage, deductionLine, isAdultApplicant, EMPLOYMENT_STATUSES } from '~/lib/membership-record';

  const COOLDOWN_KEY = 'mf-last-submit-ts';
  const COOLDOWN_MS = 60_000; // 1 minute
  const WORKER_URL = 'https://isatucmpc-forms.jianjchavez.workers.dev/api/submit';
  const PMES_ADMIN_URL = 'https://isatucmpc-forms.jianjchavez.workers.dev/api/pmes/admin';

  const form = document.getElementById('membership-form') as HTMLFormElement | null;
  if (form) {
    const submitBtn = form.querySelector('button[type=submit]') as HTMLButtonElement | null;
    const cooldownEl = document.getElementById('mf-cooldown');
    const associate = document.getElementById('mf-associate-block');
    const regular = document.getElementById('mf-regular-block');
    const isatuChk = document.getElementById('mf-isatu') as HTMLInputElement | null;
    const campusRow = document.getElementById('mf-campus-row');
    const recommender = document.getElementById('mf-recname') as HTMLInputElement | null;
    const assocOrgRow = document.getElementById('mf-assocorg-row');
    const resultEl = document.getElementById('mf-result');
    let submitting = false;

    // Every submit failure says what went wrong and what to do next. The code is shown so the office can tell which one it was.
    const CONTACT = 'call (033) 330-2586 or email isatucmpc1964@gmail.com';
    const VERIFY = 'The "Verify you are human" check above did not load or did not finish. Wait for its green checkmark, then submit again. If the box stays grey or empty, refresh the page, turn off ad or script blockers for this site, or use another browser (Chrome, Edge or Safari).';
    const SUBMIT_ERRORS: Record<string, string> = {
      'no-turnstile': VERIFY,
      'turnstile-failed': VERIFY,
      'missing-fields': VERIFY,
      'network': 'We could not reach our server. Check your internet connection (open any other website to test), then submit again. Your answers are still on this page.',
      'rate-limited': 'Too many tries from this connection. Wait one minute, then submit again.',
      'invalid-mobile': 'Your mobile number could not be read. Enter it as 11 digits starting with 09 (for example 0917 123 4567), then submit again.',
      'invalid-email': 'Your email address could not be read. Check it (for example juan@gmail.com), then submit again.',
      'invalid-subscription': 'Check the share subscription: at least 50 shares and at least 1 year to pay, both whole numbers. Then submit again.',
      'invalid-applicant': 'Some details could not be read. Check that your birth date shows you are 18 or older, and that your name, mobile number and email are filled in, then submit again.',
      'invalid-body': 'Some details could not be read. Refresh the page, fill in the form again, and submit.',
      'forbidden': 'This form only works on isatucmpc.coop. Open isatucmpc.coop/membership in your browser and fill it in there.',
      'storage-failed': `Our server could not save your application right now. Wait a few minutes and submit again. If it keeps happening, ${CONTACT}.`,
      'send-failed': `Your application may have been saved, but our email did not go out. Please do not submit again yet: ${CONTACT} and we will check it for you.`,
      unknown: `Something went wrong on our side. Wait a few minutes and submit again. If it keeps happening, ${CONTACT}.`,
    };

    function showResult(text: string, success: boolean) {
      if (!resultEl) return;
      resultEl.style.background = success ? '#23CD63' : '#FF3F00';
      resultEl.style.color = 'white';
      resultEl.textContent = text;
      resultEl.classList.remove('hidden');
    }

    function val(sel: string): string {
      const el = form!.querySelector(sel) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
      return (el?.value ?? '').trim();
    }

    function syncType() {
      const t = (form!.querySelector('input[name="mf-membertype"]:checked') as HTMLInputElement | null)?.value;
      const isAssoc = t === 'Associate';
      const isReg = t === 'Regular';
      associate?.classList.toggle('hidden', !isAssoc);
      regular?.classList.toggle('hidden', !isReg);
      if (recommender) recommender.required = isAssoc;
      if (!isReg && isatuChk) {
        isatuChk.checked = false;
        campusRow?.classList.add('hidden');
        (document.getElementById('mf-campus') as HTMLSelectElement | null)?.removeAttribute('required');
      }
    }
    form.querySelectorAll('input[name="mf-membertype"]').forEach(el => el.addEventListener('change', syncType));
    // Spouse's name is required only for a married applicant.
    const spouse = document.getElementById('mf-spname') as HTMLInputElement | null;
    form.querySelectorAll('input[name="mf-civil"]').forEach(el => el.addEventListener('change', () => {
      const married = (form!.querySelector('input[name="mf-civil"]:checked') as HTMLInputElement | null)?.value === 'Married';
      if (spouse) spouse.required = married;
      document.getElementById('mf-spname-star')?.classList.toggle('hidden', !married);
    }));
    form.addEventListener('reset', () => {
      if (spouse) spouse.required = false;
      document.getElementById('mf-spname-star')?.classList.add('hidden');
    });
    // Campus is required once the applicant says they are an ISAT U employee (hidden fields are skipped by the check below).
    const campusSel = document.getElementById('mf-campus') as HTMLSelectElement | null;
    isatuChk?.addEventListener('change', () => {
      campusRow?.classList.toggle('hidden', !isatuChk.checked);
      if (campusSel) campusSel.required = isatuChk.checked;
    });
    form.querySelectorAll('input[name="mf-assocqual"]').forEach(el => el.addEventListener('change', () => {
      const q = (form!.querySelector('input[name="mf-assocqual"]:checked') as HTMLInputElement | null)?.value;
      // Show the "specify" textbox unless the user is in the SEC-registered-organization branch
      // (PDF places the org name on its own labelled line; the "relationship" branch needs a specifier too).
      assocOrgRow?.classList.toggle('hidden', !q || q === 'organization');
    }));

    // ---- "Same as present home address" keeps the permanent address in step with the present one ----
    const presentAddr = document.getElementById('mf-paddr') as HTMLInputElement | null;
    const homeAddr = document.getElementById('mf-haddr') as HTMLInputElement | null;
    const sameAddr = document.getElementById('mf-sameaddr') as HTMLInputElement | null;
    function syncAddr() {
      if (!homeAddr || !sameAddr) return;
      homeAddr.readOnly = sameAddr.checked;
      if (sameAddr.checked) homeAddr.value = presentAddr?.value ?? '';
    }
    sameAddr?.addEventListener('change', syncAddr);
    presentAddr?.addEventListener('input', syncAddr);
    form.addEventListener('reset', () => { if (homeAddr) homeAddr.readOnly = false; });

    // ---- Beneficiaries: copy the spouse or parent from Family information into the first empty row ----
    const field = (f: string) => form!.querySelector(`[data-field="${f}"]`) as HTMLInputElement | null;
    const benNote = document.getElementById('mf-ben-note');
    const copyButtons = [
      { btn: document.getElementById('mf-ben-spouse') as HTMLButtonElement | null, name: 'spouseName', dob: 'spouseDob', rel: 'Spouse' },
      { btn: document.getElementById('mf-ben-parent') as HTMLButtonElement | null, name: 'parentName', dob: 'parentDob', rel: 'Parent' },
    ];
    function syncCopyButtons() {
      for (const c of copyButtons) if (c.btn) c.btn.disabled = !field(c.name)?.value.trim();
    }
    for (const c of copyButtons) {
      field(c.name)?.addEventListener('input', syncCopyButtons);
      c.btn?.addEventListener('click', () => {
        const name = field(c.name)?.value.trim() ?? '';
        const dob = field(c.dob)?.value ?? '';
        if (!name) return;
        const rows = [1, 2];
        if (rows.some(i => field(`ben${i}Name`)?.value.trim().toLowerCase() === name.toLowerCase())) {
          if (benNote) benNote.textContent = `${name} is already listed.`;
          return;
        }
        const row = rows.find(i => !field(`ben${i}Name`)?.value.trim());
        if (!row) { if (benNote) benNote.textContent = 'Both beneficiary rows are filled. Clear one first.'; return; }
        field(`ben${row}Name`)!.value = name;
        field(`ben${row}Dob`)!.value = dob;
        field(`ben${row}Rel`)!.value = c.rel;
        const age = dob ? Math.floor((Date.now() - new Date(dob).getTime()) / 31557600000) : NaN;
        field(`ben${row}Age`)!.value = age >= 0 ? String(age) : '';
        if (benNote) benNote.textContent = `Added ${name} as beneficiary ${row}.`;
      });
    }
    form.addEventListener('reset', () => setTimeout(syncCopyButtons));
    syncCopyButtons();

    // ---- cooldown lockout ----
    function applyCooldown() {
      if (!cooldownEl) return false;
      const last = Number(localStorage.getItem(COOLDOWN_KEY) || '0');
      const elapsed = Date.now() - last;
      if (last && elapsed < COOLDOWN_MS) {
        const seconds = Math.ceil((COOLDOWN_MS - elapsed) / 1000);
        cooldownEl.textContent = `You submitted recently. Please wait ${seconds}s before submitting again. If your download didn't start, check your browser's downloads folder.`;
        cooldownEl.classList.remove('hidden');
        if (submitBtn) submitBtn.disabled = true;
        setTimeout(applyCooldown, 1000);
        return true;
      }
      cooldownEl.classList.add('hidden');
      if (submitBtn) submitBtn.disabled = false;
      return false;
    }
    applyCooldown();

    // ---- share subscription: whole numbers, at least MIN_SHARES ----
    const sharesInput = document.getElementById('mf-shares') as HTMLInputElement | null;
    const yearsInput = document.getElementById('mf-years') as HTMLInputElement | null;
    const amountEl = document.getElementById('mf-amount');
    const wholeNumber = (el: HTMLInputElement | null) => (/^\d+$/.test(el?.value.trim() ?? '') ? Number(el!.value) : NaN);
    function showAmount() {
      const shares = wholeNumber(sharesInput);
      if (amountEl) amountEl.textContent = shares >= MIN_SHARES ? `= PHP ${formatAmount(shares * PAR_VALUE)}` : '';
    }
    sharesInput?.addEventListener('input', showAmount);
    showAmount();

    // ---- ISAT U salary deduction preview (same numbers as the Authority to Deduct) ----
    const deductionEl = document.getElementById('mf-deduction');
    const dobInput = form.querySelector('[data-field="dob"]') as HTMLInputElement | null;
    function showDeduction() {
      const line = deductionLine({
        isatuEmployee: !!isatuChk?.checked, shares: wholeNumber(sharesInput), years: wholeNumber(yearsInput), dateOfBirth: dobInput?.value ?? '',
      });
      if (deductionEl) deductionEl.textContent = line ? `Monthly salary deduction: ${line}` : '';
    }
    [sharesInput, yearsInput, dobInput, isatuChk].forEach(el => el?.addEventListener('input', showDeduction));
    isatuChk?.addEventListener('change', showDeduction);
    showDeduction();

    // Runs first (capture phase on the form): invalid values stop the submit and PDF.
    form.addEventListener('submit', e => {
      const shares = wholeNumber(sharesInput);
      const years = wholeNumber(yearsInput);
      // First visible required field left empty (hidden branches such as the associate block are skipped).
      const missing = Array.from(form!.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]'))
        .find(el => !el.checkValidity() && (el.offsetParent !== null || el.type === 'radio'));
      const missingLabel = missing && (missing.type === 'radio' || missing.type === 'checkbox'
        ? (missing.closest('fieldset')?.querySelector('legend')?.textContent ?? '')
        : (missing.labels?.[0]?.textContent ?? '')).replace('*', '').replace(/^\d+\.\s*/, '').trim();
      const problem = missing
        ? { el: missing as HTMLInputElement, text: missing.id === 'mf-consent'
          ? 'Please tick the Privacy Notice consent box.'
          : `Please fill in the required field${missingLabel ? `: ${missingLabel}` : ''}.` }
        : !(shares >= MIN_SHARES)
        ? { el: sharesInput, text: `Please subscribe to at least ${MIN_SHARES} shares (whole number).` }
        : !(years >= 1)
          ? { el: yearsInput, text: 'Please enter how many years you will pay your subscription (whole number).' }
          : !isAdultApplicant(val('[data-field="dob"]'))
            ? { el: form!.querySelector('[data-field="dob"]') as HTMLInputElement | null, text: 'Applicants must be at least 18 years old.' }
            : null;
      if (!problem) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      const resultEl = document.getElementById('mf-result');
      if (resultEl) {
        resultEl.style.background = '#FF3F00';
        resultEl.style.color = 'white';
        resultEl.textContent = problem.text;
        resultEl.classList.remove('hidden');
      }
      problem.el?.focus();
    }, true);

    // ---- capture-phase: pack hidden name + message before submitting ----
    form.addEventListener('submit', () => {
      const first = val('[data-field="firstName"]');
      const middle = val('[data-field="middleName"]');
      const last = val('[data-field="lastName"]');
      (form!.elements.namedItem('name') as HTMLInputElement).value = [first, middle, last].filter(Boolean).join(' ') || '(no name)';

      const read = (field: string) => field === 'email' ? val('[name="email"]') : val(`[data-field="${field}"]`);
      const checked = (field: string) =>
        (form!.querySelector(`[data-field="${field}"]:checked`) as HTMLInputElement | null)?.value || '';
      const flags = {
        isatuEmployee: !!isatuChk?.checked,
        consent: !!(form!.querySelector('#mf-consent') as HTMLInputElement | null)?.checked,
        shares: wholeNumber(sharesInput),
        years: wholeNumber(yearsInput),
      };
      (form!.elements.namedItem('message') as HTMLInputElement).value = buildApplicantMessage(read, checked, flags);
      (form!.elements.namedItem('applicant') as HTMLInputElement).value = JSON.stringify(buildApplicantRecord(read, checked, flags));
    }, true);  // capture phase

    // ---- bubble-phase: wait for the application number before building the PDF ----
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitting) return;
      const variant = (form!.querySelector('input[name="mf-membertype"]:checked') as HTMLInputElement | null)?.value;
      if (variant !== 'Regular' && variant !== 'Associate') { showResult('Please choose Regular or Associate membership.', false); return; }

      // Staff walk-in: the presenter's sign-in (this tab's sessionStorage) adds the paper application to the session.
      const staffSession = form!.dataset.staff ? new URLSearchParams(location.search).get('id') : null;
      if (form!.dataset.staff) {
        const token = (JSON.parse(sessionStorage.getItem('pmes_admin') ?? '{}') as { token?: string }).token;
        if (!staffSession || !token) { showResult('Sign in at /pmes/admin/ first, then open Add walk-in from the session.', false); return; }
        submitting = true;
        if (submitBtn) submitBtn.disabled = true;
        try {
          const res = await fetch(`${PMES_ADMIN_URL}/sessions/${encodeURIComponent(staffSession)}/walk-in`, {
            method: 'POST',
            headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
            body: JSON.stringify({ applicant: (form!.elements.namedItem('applicant') as HTMLInputElement).value }),
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(json.error || 'failed');
          showResult(`${json.fullName}: application number ${json.applicationNo}, checked in. Write this number on the paper form.`, true);
          form!.reset();
          window.scrollTo({ top: 0 });
        } catch (err) {
          const code = (err as Error).message;
          showResult(code === 'invalid-applicant' ? 'Please check the entries: some details could not be read (birth date 18+, mobile 09XX XXX XXXX, email).'
            : code === 'not-attendance-session' ? 'This session is closed or is not a face-to-face session.'
            : code === 'unauthorized' ? 'Your sign-in expired. Sign in again at /pmes/admin/.'
            : 'Could not add the walk-in. Please try again.', false);
        } finally {
          submitting = false;
          if (submitBtn) submitBtn.disabled = false;
        }
        return;
      }

      // Block multiple submits during cooldown
      const last = Number(localStorage.getItem(COOLDOWN_KEY) || '0');
      if (last && Date.now() - last < COOLDOWN_MS) { e.preventDefault(); applyCooldown(); return; }

      submitting = true;
      resultEl?.classList.add('hidden');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.setAttribute('aria-busy', 'true');
        submitBtn.textContent = 'Submitting application…';
      }

      let applicationNo: string;
      try {
        const formData = Object.fromEntries(new FormData(form!).entries());
        formData['cf-turnstile-response'] = formData['cf-turnstile-response'] || val('[name="cf-turnstile-response"]');
        if (!formData['cf-turnstile-response']) throw new Error('no-turnstile');
        const response = await fetch(WORKER_URL, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(formData),
        }).catch(() => { throw new Error('network'); });
        const json = await response.json().catch(() => ({ error: `http-${response.status}` }));
        if (!response.ok || !json.ok || typeof json.applicationNo !== 'string' || !/^APP-\d{4}-\d{4,}$/.test(json.applicationNo)) {
          throw new Error(json.error || 'submit-failed');
        }
        applicationNo = json.applicationNo;
        localStorage.setItem(COOLDOWN_KEY, String(Date.now()));
      } catch (err) {
        const code = (err as Error).message;
        showResult(`${SUBMIT_ERRORS[code] ?? SUBMIT_ERRORS.unknown} (Error code: ${code})`, false);
        resultEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        (window as unknown as { turnstile?: { reset(el: Element): void } }).turnstile?.reset(form!.querySelector('.cf-turnstile')!);
        submitting = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.removeAttribute('aria-busy');
          submitBtn.textContent = 'Submit & download my application';
        }
        return;
      }

      if (submitBtn) submitBtn.textContent = 'Generating PDF…';

      const bens = [1, 2].map(i => ({
        name: val(`[data-field="ben${i}Name"]`),
        dob: val(`[data-field="ben${i}Dob"]`),
        relationship: val(`[data-field="ben${i}Rel"]`),
        age: val(`[data-field="ben${i}Age"]`),
      })).filter(b => b.name);

      const data: PdfFieldData = {
        applicationNo,
        firstName: val('[data-field="firstName"]'),
        middleName: val('[data-field="middleName"]'),
        lastName: val('[data-field="lastName"]'),
        extension: val('[data-field="extension"]'),
        dob: val('[data-field="dob"]'),
        placeOfBirth: val('[data-field="placeOfBirth"]'),
        email: val('[name="email"]'),
        contactNumber: val('[data-field="contactNumber"]'),
        gender: (form!.querySelector('input[name="mf-gender"]:checked') as HTMLInputElement | null)?.value,
        civilStatus: (form!.querySelector('input[name="mf-civil"]:checked') as HTMLInputElement | null)?.value,
        presentHomeAddress: val('[data-field="presentHomeAddress"]'),
        homeAddress: val('[data-field="homeAddress"]'),
        tinNumber: val('[data-field="tinNumber"]'),
        validIdNumber: val('[data-field="validIdNumber"]'),
        employmentCategory: (form!.querySelector('input[name="mf-empcat"]:checked') as HTMLInputElement | null)?.value,
        statusOfEmployment: EMPLOYMENT_STATUSES.find(s => s.value === val('[data-field="statusOfEmployment"]'))?.label ?? val('[data-field="statusOfEmployment"]'),
        profession: val('[data-field="profession"]'),
        emergencyName: val('[data-field="emergencyName"]'),
        emergencyContact: val('[data-field="emergencyContact"]'),
        emergencyRelationship: val('[data-field="emergencyRelationship"]'),
        isatuEmployee: !!isatuChk?.checked,
        campus: val('[data-field="campus"]'),
        associateQualification: (form!.querySelector('input[name="mf-assocqual"]:checked') as HTMLInputElement | null)?.value,
        associateOrgSpecify: val('[data-field="associateOrgSpecify"]'),
        recommenderName: val('[data-field="recommenderName"]'),
        recommenderRelationship: val('[data-field="recommenderRelationship"]'),
        recommenderCampus: val('[data-field="recommenderCampus"]'),
        spouseName: val('[data-field="spouseName"]'),
        spouseDob: val('[data-field="spouseDob"]'),
        spouseContact: val('[data-field="spouseContact"]'),
        parentName: val('[data-field="parentName"]'),
        parentDob: val('[data-field="parentDob"]'),
        parentContact: val('[data-field="parentContact"]'),
        beneficiaries: bens,
        sharesSubscribed: Number(val('#mf-shares')),
        yearsToPay: Number(val('#mf-years')),
        dateAccomplished: new Date().toLocaleDateString('en-CA'), // YYYY-MM-DD in the applicant's time zone
      };

      try {
        const bytes = await fillApplicationPdf(variant, data);
        const safe = [data.lastName, data.firstName].filter(Boolean).join('_').replace(/[^a-zA-Z0-9_-]/g, '') || 'applicant';
        triggerPdfDownload(bytes, `ISATUCMPC_${variant}_Application_${safe}.pdf`);
        const online = (form!.querySelector('[data-field="pmesMode"]:checked') as HTMLInputElement | null)?.value === 'online';
        showResult(online
          ? `Application number ${applicationNo}: your application PDF is downloading. Next, take the PMES online at isatucmpc.coop/pmes with this number and your mobile number.`
          : `Application number ${applicationNo}: your application PDF is downloading. Bring the printed, signed form and this number to the PMES. Our face-to-face PMES is held every Wednesday, except holidays. Just contact us to confirm the date that works for you.`, true);
        if (online && resultEl) {
          const link = document.createElement('a');
          link.href = '/pmes/';
          link.className = 'block mt-2 underline font-bold text-white';
          link.textContent = 'Go to the online PMES now →';
          resultEl.append(link);
        }
        form!.reset();
        (window as unknown as { turnstile?: { reset(el: Element): void } }).turnstile?.reset(form!.querySelector('.cf-turnstile')!);
      } catch (err) {
        console.error('PDF fill failed', err);
        showResult(`Application number ${applicationNo}: we received your form but couldn't generate the PDF. Please email isatucmpc1964@gmail.com and include your application number.`, false);
        // The token was spent on the successful submit.
        (window as unknown as { turnstile?: { reset(el: Element): void } }).turnstile?.reset(form!.querySelector('.cf-turnstile')!);
      } finally {
        submitting = false;
        if (submitBtn) {
          submitBtn.removeAttribute('aria-busy');
          submitBtn.textContent = 'Submit & download my application';
          // applyCooldown re-disables if still within window
          applyCooldown();
        }
      }
    });
  }
</script>
