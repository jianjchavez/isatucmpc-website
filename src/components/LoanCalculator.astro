---
import Button from '~/components/Button.astro';
---

<div id="loan-calculator" class="grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
  <form class="bg-white border-t-[3px] border-navy rounded-b-lg p-6 md:p-8 shadow-sm" novalidate>
    <div class="font-display font-bold text-[11px] uppercase tracking-[0.2em] text-orange mb-3">
      Your estimate
    </div>
    <h2 class="text-2xl md:text-3xl">Enter your own loan assumptions.</h2>
    <p class="mt-2 text-sm text-slate">
      All calculations stay in your browser. No personal information is collected or sent.
    </p>

    <div class="mt-7 space-y-5">
      <label class="block">
        <span class="calc-label">Loan amount (₱)</span>
        <input
          class="calc-input"
          name="amount"
          type="number"
          min="1000"
          max="10000000"
          step="1000"
          value="100000"
          inputmode="decimal"
          required
          aria-describedby="amount-help"
        />
        <span id="amount-help" class="calc-help">₱1,000 to ₱10,000,000</span>
      </label>

      <label class="block">
        <span class="calc-label">Term in months</span>
        <input
          class="calc-input"
          name="termMonths"
          type="number"
          min="1"
          max="360"
          step="1"
          value="12"
          inputmode="numeric"
          required
          aria-describedby="term-help"
        />
        <span id="term-help" class="calc-help">1 to 360 whole months</span>
      </label>

      <label class="block">
        <span class="calc-label">Annual interest rate (%)</span>
        <input
          class="calc-input"
          name="annualRatePercent"
          type="number"
          min="0.1"
          max="60"
          step="0.1"
          value="12"
          inputmode="decimal"
          required
          aria-describedby="rate-help"
        />
        <span id="rate-help" class="calc-help"
          >Enter your own illustrative rate, from 0.1% to 60% per year.</span
        >
      </label>

      <fieldset>
        <legend class="calc-label mb-3">Computation method</legend>
        <div class="space-y-3">
          <label class="method-option">
            <input type="radio" name="method" value="straight" checked />
            <span
              ><strong>Straight</strong><small
                >Interest is based on the original loan amount for every month.</small
              ></span
            >
          </label>
          <label class="method-option">
            <input type="radio" name="method" value="diminishing-balance" />
            <span
              ><strong>Diminishing balance</strong><small
                >Interest is based on the remaining balance, so the interest share gets smaller.</small
              ></span
            >
          </label>
        </div>
      </fieldset>
    </div>

    <p
      class="hidden mt-5 rounded-lg bg-error/10 p-3 text-sm font-semibold text-error"
      data-validation
      role="alert"
    >
      Check the highlighted fields and use values within the stated ranges.
    </p>
  </form>

  <div class="space-y-6" aria-live="polite">
    <section
      class="bg-navy text-white rounded-lg p-6 md:p-8 shadow-sm"
      aria-labelledby="estimate-heading"
    >
      <div class="font-display font-bold text-[11px] uppercase tracking-[0.2em] text-orange mb-3">
        Illustrative result
      </div>
      <h2 id="estimate-heading" class="text-2xl md:text-3xl text-white">Estimated repayments</h2>

      <div class="mt-7 grid sm:grid-cols-3 gap-4">
        <div class="sm:col-span-3 border-b border-white/15 pb-5" data-straight-payment>
          <div class="result-label">Monthly payment</div>
          <output class="result-primary" data-monthly-payment>₱0.00</output>
        </div>
        <div
          class="hidden sm:col-span-3 grid-cols-1 sm:grid-cols-3 gap-4 border-b border-white/15 pb-5"
          data-diminishing-payments
        >
          <div>
            <div class="result-label">First month</div><output
              class="result-secondary"
              data-first-payment>₱0.00</output>
          </div>
          <div>
            <div class="result-label">Last month</div><output
              class="result-secondary"
              data-last-payment>₱0.00</output>
          </div>
          <div>
            <div class="result-label">Average / month</div><output
              class="result-secondary"
              data-average-payment>₱0.00</output>
          </div>
        </div>
        <div>
          <div class="result-label">Total interest</div><output
            class="result-secondary"
            data-total-interest>₱0.00</output>
        </div>
        <div class="sm:col-span-2">
          <div class="result-label">Total payable</div><output
            class="result-secondary"
            data-total-payable>₱0.00</output>
        </div>
      </div>
    </section>

    <details class="bg-white border-t-[3px] border-navy rounded-b-lg shadow-sm group">
      <summary
        class="cursor-pointer list-none p-5 md:p-6 font-display font-semibold text-navy flex items-center justify-between gap-4"
      >
        <span>View amortization schedule</span>
        <span
          class="text-orange text-2xl leading-none group-open:rotate-45 transition-transform"
          aria-hidden="true">+</span
        >
      </summary>
      <div
        class="overflow-x-auto border-t border-rule"
        tabindex="0"
        aria-label="Scrollable amortization schedule"
      >
        <table class="w-full min-w-[640px] text-sm">
          <thead class="bg-brand-bg text-navy font-display text-xs uppercase tracking-wide">
            <tr
              ><th>Month</th><th>Principal</th><th>Interest</th><th>Payment</th><th>Balance</th></tr
            >
          </thead>
          <tbody data-schedule></tbody>
        </table>
      </div>
    </details>

    <aside
      class="border-l-4 border-orange bg-orange/10 p-5 rounded-r-lg"
      aria-label="Important disclaimer"
    >
      <h3 class="text-base">Illustrative figures only</h3>
      <p class="mt-2 text-sm">
        This calculator is not a loan offer or approval. Official rates, charges, eligibility, and
        repayment terms are quoted at the ISATUCMPC office or upon application. Actual figures may
        differ.
      </p>
    </aside>

    <section class="bg-orange text-white rounded-lg p-6 md:p-8">
      <h2 class="text-2xl text-white">Ready to discuss your options?</h2>
      <p class="mt-2 text-white/90">
        Apply at the office or contact our team for the official terms available to you.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <Button
          href="/membership"
          variant="primary"
          showArrow
          className="!bg-navy !text-white hover:!bg-navy/90 justify-center"
          >Apply at the office</Button
        >
        <Button
          href="/contact"
          variant="outline"
          className="!border-white !text-white hover:!bg-white hover:!text-navy justify-center"
          >Contact us</Button
        >
      </div>
    </section>
  </div>
</div>

<style>
  .calc-label {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-navy);
  }
  .calc-input {
    width: 100%;
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    padding: 0.75rem 0.9rem;
    background: white;
    color: var(--color-ink);
  }
  .calc-input:hover {
    border-color: var(--color-navy);
  }
  .calc-input:invalid {
    border-color: var(--color-red);
  }
  .calc-help {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-slate);
    font-size: 0.75rem;
  }
  .method-option {
    display: flex;
    gap: 0.75rem;
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    padding: 0.85rem;
    cursor: pointer;
  }
  .method-option:has(input:checked) {
    border-color: var(--color-navy);
    background: color-mix(in srgb, var(--color-navy) 5%, white);
  }
  .method-option input {
    margin-top: 0.2rem;
    accent-color: var(--color-navy);
  }
  .method-option strong,
  .method-option small {
    display: block;
  }
  .method-option strong {
    font-family: var(--font-display);
    color: var(--color-navy);
    font-size: 0.875rem;
  }
  .method-option small {
    margin-top: 0.2rem;
    color: var(--color-slate);
    line-height: 1.45;
  }
  .result-label {
    margin-bottom: 0.35rem;
    color: rgb(255 255 255 / 0.7);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .result-primary {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 800;
    color: white;
  }
  .result-secondary {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
  }
  th,
  td {
    padding: 0.75rem 1rem;
    text-align: right;
    white-space: nowrap;
  }
  th:first-child,
  td:first-child {
    text-align: left;
  }
  tbody :global(tr) {
    border-top: 1px solid var(--color-rule);
  }
  tbody :global(tr:nth-child(even)) {
    background: var(--color-bg);
  }
</style>

<script>
  import { calculateLoan, clampLoanInputs, type LoanInputs, type LoanMethod } from '~/lib/loanMath';

  const root = document.getElementById('loan-calculator');
  const form = root?.querySelector('form');
  const currency = new Intl.NumberFormat('en-PH', {
    style: 'currency',
    currency: 'PHP',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

  if (root && form) {
    const fields = {
      amount: form.elements.namedItem('amount') as HTMLInputElement,
      termMonths: form.elements.namedItem('termMonths') as HTMLInputElement,
      annualRatePercent: form.elements.namedItem('annualRatePercent') as HTMLInputElement,
    };
    const validation = form.querySelector<HTMLElement>('[data-validation]')!;

    const readInputs = (): LoanInputs => ({
      amount: fields.amount.valueAsNumber,
      termMonths: fields.termMonths.valueAsNumber,
      annualRatePercent: fields.annualRatePercent.valueAsNumber,
      method: (new FormData(form).get('method') ?? 'straight') as LoanMethod,
    });

    const render = () => {
      const valid =
        form.checkValidity() &&
        Object.values(fields).every((field) => Number.isFinite(field.valueAsNumber));
      validation.classList.toggle('hidden', valid);
      if (!valid) return;

      const result = calculateLoan(readInputs());
      const setMoney = (selector: string, value: number) => {
        const output = root.querySelector<HTMLOutputElement>(selector);
        if (output) output.value = currency.format(value);
      };

      setMoney('[data-monthly-payment]', result.monthlyPayment);
      setMoney('[data-first-payment]', result.firstPayment);
      setMoney('[data-last-payment]', result.lastPayment);
      setMoney('[data-average-payment]', result.averagePayment);
      setMoney('[data-total-interest]', result.totalInterest);
      setMoney('[data-total-payable]', result.totalPayable);

      const diminishing = result.inputs.method === 'diminishing-balance';
      root.querySelector('[data-straight-payment]')?.classList.toggle('hidden', diminishing);
      const diminishingBlock = root.querySelector('[data-diminishing-payments]');
      diminishingBlock?.classList.toggle('hidden', !diminishing);
      diminishingBlock?.classList.toggle('grid', diminishing);

      const tbody = root.querySelector<HTMLTableSectionElement>('[data-schedule]');
      if (tbody) {
        const fragment = document.createDocumentFragment();
        result.schedule.forEach((row) => {
          const tr = document.createElement('tr');
          [
            String(row.month),
            currency.format(row.principal),
            currency.format(row.interest),
            currency.format(row.payment),
            currency.format(row.balance),
          ].forEach((value) => {
            const td = document.createElement('td');
            td.textContent = value;
            tr.append(td);
          });
          fragment.append(tr);
        });
        tbody.replaceChildren(fragment);
      }
    };

    form.addEventListener('input', render);
    form.addEventListener('change', (event) => {
      if ((event.target as HTMLInputElement).type === 'radio') return;
      const clamped = clampLoanInputs(readInputs());
      fields.amount.value = String(clamped.amount);
      fields.termMonths.value = String(clamped.termMonths);
      fields.annualRatePercent.value = String(clamped.annualRatePercent);
      render();
    });
    render();
  }
</script>
