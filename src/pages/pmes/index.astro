---
import PageLayout from '~/layouts/PageLayout.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Button from '~/components/Button.astro';

const input = 'w-full border-2 border-rule focus:border-navy rounded-md px-3 py-2 text-sm';
const label = 'block text-xs font-display font-bold text-navy uppercase tracking-wider mb-1';
---
<PageLayout title="PMES Certification Quiz" description="Pre-Membership Education Seminar certification quiz for ISATUCMPC applicants and members." noIndex={true}>
  <section class="bg-brand-bg min-h-screen py-10 md:py-16">
    <div class="max-w-xl mx-auto px-4">

      <!-- 1. Identity + session code -->
      <form id="pmes-form" class="bg-white border-t-[3px] border-orange rounded-b-lg p-6 md:p-8 space-y-5" novalidate>
        <div>
          <Eyebrow>PMES</Eyebrow>
          <h1 class="mt-2 text-3xl">Certification Quiz</h1>
          <p class="mt-2 text-sm text-slate">20 questions, 30 seconds each, pass mark 16. Enter your details and the session code from the presenter.</p>
        </div>
        <div>
          <label for="pf-idtype" class={label}>Identity</label>
          <select id="pf-idtype" name="idType" class={input}>
            <option value="application">Membership Application Number</option>
            <option value="member">Member Number</option>
          </select>
        </div>
        <div>
          <label for="pf-idnumber" class={label}>Number</label>
          <input id="pf-idnumber" name="idNumber" type="text" required autocomplete="off" class={input} />
          <p id="pf-number-help" class="mt-1 text-xs text-slate">The APP- number printed on your application form.</p>
        </div>
        <div id="pf-name-fields" class="hidden">
          <label for="pf-name" class={label}>Full name</label>
          <input id="pf-name" name="fullName" type="text" autocomplete="name" class={input} />
        </div>
        <div>
          <label for="pf-mobile" class={label}>Mobile number</label>
          <input id="pf-mobile" name="mobile" type="tel" required placeholder="09XXXXXXXXX" autocomplete="tel-national" class={input} />
        </div>
        <div id="pf-email-fields" class="hidden">
          <label for="pf-email" class={label}>Email</label>
          <input id="pf-email" name="email" type="email" autocomplete="email" class={input} />
        </div>
        <label class="flex items-start gap-2 text-sm">
          <input id="pf-consent" name="consent" type="checkbox" required class="mt-0.5" />
          <span>I consent to ISATUCMPC processing my name, application or member number, mobile number, email and quiz answers for membership processing, under the Data Privacy Act of 2012 and the cooperative's <a href="/privacy" class="underline underline-offset-2 text-navy font-semibold" target="_blank">privacy notice</a>.</span>
        </label>
        <div>
          <label for="pf-code" class={label}>Session code</label>
          <input id="pf-code" name="code" type="text" required placeholder="PMES-XXXX" maxlength="9" autocomplete="off" autocapitalize="characters" spellcheck="false" class={`${input} uppercase font-display font-bold tracking-widest`} />
        </div>
        <div class="cf-turnstile" data-sitekey="0x4AAAAAADX7ERaWq-wd4wB5"></div>
        <Button type="submit" variant="primary" size="md" showArrow>Start the quiz</Button>
        <div id="pf-error" class="hidden p-3 rounded text-sm bg-error text-white" role="alert"></div>
      </form>

      <!-- 2. Quiz -->
      <div id="pmes-quiz" class="hidden bg-white border-t-[3px] border-navy rounded-b-lg p-6 md:p-8 space-y-5">
        <p id="pq-name" class="font-display font-semibold text-navy"></p>
        <div class="flex items-center justify-between text-sm">
          <div id="pq-progress" class="font-display font-bold text-navy" aria-live="polite"></div>
          <div id="pq-timer" class="hidden font-display font-bold text-navy tabular-nums" role="timer" aria-live="polite"></div>
        </div>
        <div class="h-1.5 bg-rule rounded-full overflow-hidden" aria-hidden="true"><div id="pq-bar" class="h-full bg-orange transition-all" style="width:0%"></div></div>
        <fieldset id="pq-question" class="space-y-3">
          <legend class="mb-3">
            <span id="pq-section" class="block font-display font-bold text-[11px] uppercase tracking-[0.2em] text-orange"></span>
            <span id="pq-text" class="block text-lg font-display font-semibold text-navy mt-1 select-none"></span>
          </legend>
          <div id="pq-options" class="space-y-2"></div>
        </fieldset>
        <div class="flex justify-end">
          <button type="button" id="pq-next" class="pq-btn bg-navy text-white" disabled>Next</button>
        </div>
        <div id="pq-error" class="hidden p-3 rounded text-sm bg-error text-white" role="alert"></div>
      </div>

      <!-- 3. Result -->
      <div id="pmes-result" class="hidden bg-white border-t-[3px] rounded-b-lg p-6 md:p-8 space-y-4" role="status" aria-live="polite">
        <Eyebrow>Result</Eyebrow>
        <h2 id="pr-headline" class="text-2xl"></h2>
        <p id="pr-detail" class="text-sm"></p>
        <div id="pr-review-wrap" class="hidden">
          <div class={label}>Sections to review</div>
          <ul id="pr-review" class="list-disc pl-5 text-sm space-y-1"></ul>
        </div>
        <div id="pr-missed-wrap" class="hidden">
          <h3 class={label}>Questions you missed</h3>
          <ul id="pr-missed" class="space-y-3 text-sm"></ul>
        </div>
        <div class="flex flex-wrap gap-2 pt-2">
          <a id="pr-cert" class="hidden pq-btn bg-orange text-white no-underline" href="#">Open certificate</a>
          <button type="button" id="pr-retry" class="hidden pq-btn border-2 border-navy text-navy">Take the quiz again</button>
        </div>
      </div>

    </div>
  </section>
</PageLayout>

<style is:global>
  /* Global, not scoped: the option labels are created at runtime by the script
     below, and Astro's scoped styles only reach elements rendered at build time. */
  .pq-btn {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; border-radius: 0.5rem;
    font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.875rem; letter-spacing: 0.02em; cursor: pointer;
  }
  .pq-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .pq-btn.hidden { display: none; } /* .pq-btn's display would otherwise beat Tailwind's .hidden */
  .pq-opt { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.75rem 1rem; border: 2px solid #E8E8E8; border-radius: 0.5rem; cursor: pointer; font-size: 0.95rem; user-select: none; }
  .pq-opt:has(input:checked) { border-color: #010066; background: rgba(1, 0, 102, 0.05); }
  .pq-opt:has(input:focus-visible) { outline: 2px solid #FE9900; outline-offset: 2px; }
  .pq-opt input { margin-top: 0.3rem; accent-color: #010066; }
</style>

<script>
  import {
    deadlineFromStep, isStep, renderResult, formatClock, sectionTitle, errorMessage,
    type StartRequest, type Step, type Final, type QuizResponse,
  } from '~/components/pmes-logic';

  const WORKER = 'https://isatucmpc-forms.jianjchavez.workers.dev';
  const STORE = 'pmes-attempt';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('pmes-form');
  const quiz = $('pmes-quiz'), result = $('pmes-result');
  const turnstileEl = form.querySelector<HTMLElement>('.cf-turnstile')!;
  const idType = $<HTMLSelectElement>('pf-idtype');
  const nameInput = $<HTMLInputElement>('pf-name');
  const emailInput = $<HTMLInputElement>('pf-email');
  const nameFields = $('pf-name-fields');
  const emailFields = $('pf-email-fields');
  const next = $<HTMLButtonElement>('pq-next');
  let step: Step | null = null;
  let selected: number | null = null;
  let deadlineMs = 0;
  let timer: ReturnType<typeof setInterval> | undefined;
  let inFlight = false;

  function identityChanged() {
    const isApplication = idType.value === 'application';
    nameFields.classList.toggle('hidden', isApplication);
    emailFields.classList.toggle('hidden', isApplication);
    nameInput.required = !isApplication;
    emailInput.required = !isApplication;
    $('pf-number-help').classList.toggle('hidden', !isApplication);
  }
  idType.addEventListener('change', identityChanged);
  identityChanged();

  function show(screen: HTMLElement) {
    for (const el of [form, quiz, result]) el.classList.toggle('hidden', el !== screen);
    window.scrollTo({ top: 0 });
  }
  function setError(el: HTMLElement, msg: string | null) {
    el.textContent = msg ?? '';
    el.classList.toggle('hidden', !msg);
  }
  class ApiError extends Error {
    constructor(code: string) { super(code); }
  }
  async function post<T>(path: string, body: unknown): Promise<T> {
    for (let retries = 0; ; retries++) {
      let res: Response;
      try {
        res = await fetch(`${WORKER}${path}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      } catch { throw new ApiError('generic'); }
      const json = await res.json().catch(() => ({}));
      if (res.status === 503 && json.error === 'attempt-finalizing' && retries < 5) {
        await new Promise(resolve => setTimeout(resolve, 1000));
        continue;
      }
      if (!res.ok) throw new ApiError(json.error || (res.status === 429 ? 'rate-limited' : 'generic'));
      return json as T;
    }
  }
  function resetTurnstile() {
    (window as unknown as { turnstile?: { reset(el: Element): void } }).turnstile?.reset(turnstileEl);
  }

  form.addEventListener('submit', async e => {
    e.preventDefault();
    setError($('pf-error'), null);
    if (!form.reportValidity()) return;
    const fd = new FormData(form);
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    btn.disabled = true;
    try {
      const common = {
        code: String(fd.get('code')).trim().toUpperCase(),
        idNumber: String(fd.get('idNumber')).trim(),
        mobile: String(fd.get('mobile')).trim(),
        consent: true as const,
        turnstile: turnstileEl.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value ?? '',
      };
      const body: StartRequest = idType.value === 'application'
        ? { ...common, idType: 'application' }
        : { ...common, idType: 'member', fullName: String(fd.get('fullName')).trim(), email: String(fd.get('email')).trim() };
      const response = await post<QuizResponse>('/api/pmes/start', body);
      // A live attempt that ran out of time comes back from /start as its result.
      if (isStep(response)) sessionStorage.setItem(STORE, response.attemptId);
      showResponse(response);
    } catch (err) {
      setError($('pf-error'), errorMessage((err as Error).message));
      resetTurnstile();
    } finally { btn.disabled = false; }
  });

  function showStep(current: Step) {
    step = current;
    selected = null;
    deadlineMs = deadlineFromStep(current, Date.now());
    $('pq-name').textContent = current.fullName;
    $('pq-progress').textContent = `Question ${current.question.n} of ${current.total}`;
    $('pq-bar').style.width = `${(current.question.n / current.total) * 100}%`;
    $('pq-section').textContent = sectionTitle(current.question.section);
    $('pq-text').textContent = current.question.text;
    $('pq-options').replaceChildren(...current.question.options.map((option, i) => {
      const label = document.createElement('label');
      label.className = 'pq-opt';
      const radio = document.createElement('input');
      radio.type = 'radio'; radio.name = 'choice'; radio.value = String(i);
      radio.addEventListener('change', () => { selected = i; next.disabled = inFlight; });
      label.append(radio, document.createTextNode(option));
      return label;
    }));
    next.textContent = current.question.n === current.total ? 'Finish' : 'Next';
    next.disabled = true;
    setError($('pq-error'), null);
    show(quiz);
    startTimer();
  }
  function startTimer() {
    clearInterval(timer);
    const tick = () => {
      if (!step) return;
      const remaining = Math.max(0, Math.ceil((deadlineMs - Date.now()) / 1000));
      const el = $('pq-timer');
      el.classList.remove('hidden');
      el.textContent = formatClock(remaining);
      el.classList.toggle('text-error', remaining <= 10);
      el.classList.toggle('text-navy', remaining > 10);
      if (remaining === 0 && !inFlight) void sendAnswer(null);
    };
    tick();
    timer = setInterval(tick, 250);
  }
  next.addEventListener('click', () => {
    if (selected !== null || Date.now() >= deadlineMs) void sendAnswer(Date.now() >= deadlineMs ? null : selected);
  });

  async function sendAnswer(choice: number | null) {
    if (!step || inFlight) return;
    const current = step;
    inFlight = true;
    next.disabled = true;
    clearInterval(timer);
    try {
      const response = await post<QuizResponse>('/api/pmes/answer', {
        attemptId: current.attemptId, n: current.question.n, choice,
      });
      showResponse(response);
    } catch (err) {
      setError($('pq-error'), errorMessage((err as Error).message));
      next.disabled = selected === null && choice !== null;
    } finally { inFlight = false; }
  }
  function showResponse(response: QuizResponse) {
    if (isStep(response)) showStep(response);
    else showResult(response);
  }

  function showResult(r: Final) {
    clearInterval(timer);
    step = null;
    sessionStorage.removeItem(STORE);
    const view = renderResult(r);
    result.classList.toggle('border-success', r.passed);
    result.classList.toggle('border-error', !r.passed);
    $('pr-headline').textContent = view.headline;
    $('pr-detail').textContent = view.detail;
    $('pr-review').replaceChildren(...view.reviewLines.map(t => {
      const li = document.createElement('li'); li.textContent = t; return li;
    }));
    $('pr-review-wrap').classList.toggle('hidden', view.reviewLines.length === 0);
    $('pr-missed').replaceChildren(...view.missedLines.map(line => {
      const li = document.createElement('li');
      li.className = 'rounded-lg border border-rule p-3 space-y-1';
      const question = document.createElement('p'); question.className = 'font-semibold text-navy'; question.textContent = line.question;
      const yours = document.createElement('p'); yours.textContent = `Your answer: ${line.yours}`;
      const correct = document.createElement('p'); correct.textContent = `Correct answer: ${line.correct}`;
      const slide = document.createElement('p'); slide.textContent = `Slide ${line.slide}`;
      li.append(question, yours, correct, slide);
      return li;
    }));
    $('pr-missed-wrap').classList.toggle('hidden', view.missedLines.length === 0);
    const cert = $<HTMLAnchorElement>('pr-cert');
    cert.classList.toggle('hidden', !r.passed);
    if (r.passed) cert.href = `/pmes/certificate/?no=${encodeURIComponent(r.certificateNo ?? '')}&key=${encodeURIComponent(r.certificateKey ?? '')}`;
    $('pr-retry').classList.toggle('hidden', r.passed || r.retakesLeft <= 0);
    show(result);
  }
  $('pr-retry').addEventListener('click', () => {
    resetTurnstile();
    show(form);
    $('pf-code').focus();
  });

  const saved = sessionStorage.getItem(STORE);
  if (saved) {
    post<QuizResponse>('/api/pmes/resume', { attemptId: saved })
      .then(showResponse)
      .catch(err => {
        if ((err as Error).message === 'unknown-attempt') sessionStorage.removeItem(STORE);
        else setError($('pf-error'), errorMessage((err as Error).message));
        show(form);
      });
  }
</script>
