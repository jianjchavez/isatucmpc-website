---
import PageLayout from '~/layouts/PageLayout.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import GradientOrb from '~/components/GradientOrb.astro';
import LoanCalculator from '~/components/LoanCalculator.astro';
---

<PageLayout
  title="Loan Calculator"
  description="Estimate illustrative loan repayments using straight or diminishing-balance computation. Enter your own amount, term, and annual interest rate."
>
  <section class="relative bg-navy text-white overflow-hidden">
    <GradientOrb position="top-right" size="md" intensity={0.22} />
    <div class="container-page py-16 md:py-24 relative">
      <Eyebrow color="orange">Plan with clarity</Eyebrow>
      <h1 class="mt-4 text-4xl md:text-5xl text-white max-w-3xl">
        Estimate a loan before you visit.
      </h1>
      <p class="mt-4 text-lg md:text-xl text-white/85 max-w-2xl font-light">
        Explore how your own amount, term, rate, and computation method shape an illustrative
        repayment schedule.
      </p>
    </div>
  </section>

  <section class="bg-brand-bg">
    <div class="container-page py-12 md:py-16">
      <LoanCalculator />
    </div>
  </section>
</PageLayout>
